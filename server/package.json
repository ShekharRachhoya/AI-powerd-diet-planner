{
  "name": "ai-health-coach-backend",
  "version": "1.0.0",
  "description": "Production Grade AI Health Coach Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "dotenvx run -- nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "docker build -t ai-health-api .",
    "docker:up": "docker compose up",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.71.0",
    "@google/genai": "^1.13.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "redis": "^5.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "jest": "^25.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
